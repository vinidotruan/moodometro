{
  "name": "moodometro-ui",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "storybook": "ng run moodometro-ui:storybook",
    "build-storybook": "ng run moodometro-ui:build-storybook",
    "emulators": "firebase emulators:start --only auth,firestore",
    "test:rules": "firebase emulators:exec --only firestore \"vitest run --config vitest.rules.config.ts\"",
    "deploy:rules": "firebase deploy --only firestore"
  },
  "private": true,
  "packageManager": "npm@10.9.9",
  "dependencies": {
    "@angular/common": "^22.3.0",
    "@angular/compiler": "^22.3.0",
    "@angular/core": "^22.3.0",
    "@angular/forms": "^22.3.0",
    "@angular/platform-browser": "^22.3.0",
    "@angular/router": "^22.3.0",
    "firebase": "^13.4.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.7.3",
    "@angular-devkit/architect": "^0.2203.0",
    "@angular-devkit/build-angular": "^22.3.0",
    "@angular-devkit/core": "^22.3.0",
    "@angular/animations": "^22.3.0",
    "@angular/build": "^22.3.0",
    "@angular/cli": "^22.3.0",
    "@angular/compiler-cli": "^22.3.0",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@storybook/addon-docs": "^10.6.7",
    "@storybook/angular-vite": "^10.6.7",
    "@types/node": "^22.0.0",
    "firebase-tools": "^15.37.0",
    "jsdom": "^31.0.0",
    "prettier": "^3.8.1",
    "storybook": "^10.6.7",
    "typescript": "~6.0.2",
    "vite": "latest",
    "vitest": "^5.0.0"
  }
}
